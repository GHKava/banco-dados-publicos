# .env.example

# Copy to .env and configure with real values

# ====== Database ======
DATABASE_URL=postgresql://user:password@localhost:5432/public_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10

# ====== Redis ======
REDIS_URL=redis://localhost:6379/0

# ====== API ======
API_KEY_SECRET=your-secret-key-here
API_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1

# ====== Embeddings ======
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-MiniLM-L6-v2
EMBEDDINGS_CACHE_DIR=./data/embeddings_cache
EMBEDDINGS_BATCH_SIZE=32

# ====== Logging ======
LOG_LEVEL=INFO
LOG_DIR=./logs
RUN_ID_PREFIX=YYYYMMDD-HHMM

# ====== Compliance ======
POLICY_GATE_MODE=fail_closed
ROBOTS_RESPECT=true
RATE_LIMIT_PER_DOMAIN=100  # requests/hour

# ====== PII / LGPD ======
PII_DETECTION_ENABLED=true
PII_REDACTION_ENABLED=true
RETENTION_DAYS=365

# ====== OCR (se necessário) ======
OCR_ENABLED=false
OCR_CONFIDENCE_THRESHOLD=0.8

# ====== Debug ======
DEBUG=false
VERBOSE_LOGGING=false
